<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- QR-Pairing: Kamera zum Scannen des Desktop-QR-Codes. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Tägliche Trainings-Erinnerung (ab Android 13 laufzeitpflichtig). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.kiebitz"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- Google Mobile Ads; lokale Builds verwenden die offizielle Test-ID,
             Produktions-Builds KIEBITZ_ADMOB_APP_ID aus dem Release-Secret. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Anmeldung per Magic-Link: Die API bietet nach dem Bestätigen
                 kiebitz://auth?code=… an. Dasselbe Schema trägt die
                 Pairing-URL des Gerätesyncs; die App unterscheidet am Pfad. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kiebitz" />
            </intent-filter>
        </activity>

        <!-- Homescreen-Widgets. Sie lesen ausschließlich die lokale
             Momentaufnahme, die die App ablegt; kein Netzzugriff, keine
             Engine, kein Hintergrundtakt (updatePeriodMillis=0). -->
        <receiver
            android:name=".widgets.TodayWidgetReceiver"
            android:label="@string/widget_today_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>
        <receiver
            android:name=".widgets.WeekGoalWidgetReceiver"
            android:label="@string/widget_week_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week_info" />
        </receiver>
        <receiver
            android:name=".widgets.QuickStartWidgetReceiver"
            android:label="@string/widget_quick_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_info" />
        </receiver>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
