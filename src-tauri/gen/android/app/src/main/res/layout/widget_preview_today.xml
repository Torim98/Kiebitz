<?xml version="1.0" encoding="utf-8"?>
<!--
  Vorschau im Widget-Auswahldialog · ein statisches Abbild dessen, was das
  Widget mit Daten zeigt. Es hat dieselbe Fläche, dieselbe Kennzahl und
  denselben Balken wie die Glance-Fassung; wer es ablegt, bekommt genau das.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_surface"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="9dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_widget_bird"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="@string/widget_today_short"
            android:textColor="@color/widget_ink2"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="@string/widget_preview_open"
            android:textColor="@color/widget_ink2"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_preview_progress"
        android:textColor="@color/widget_ink"
        android:textSize="20sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_track">

        <View
            android:layout_width="66dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_bar" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/widget_dot_tactics" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/widget_preview_unit"
            android:textColor="@color/widget_ink"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
