<?xml version="1.0" encoding="utf-8"?>
<!--
  Vorschau im Widget-Auswahldialog · statisches Abbild ohne echte Daten.
  Wie die 4×1-Fassung selbst: vier Ziele über die volle Höhe, keine
  Überschriftszeile darüber. Die Vorschau soll zeigen, was man bekommt.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <TextView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:background="@drawable/widget_preview_chip"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:maxLines="1"
        android:text="@string/widget_quick_puzzles"
        android:textColor="@color/widget_preview_ink"
        android:textSize="11sp" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:background="@drawable/widget_preview_chip"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:maxLines="1"
        android:text="@string/widget_quick_repertoire"
        android:textColor="@color/widget_preview_ink"
        android:textSize="11sp" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:background="@drawable/widget_preview_chip"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:maxLines="1"
        android:text="@string/widget_quick_endgames"
        android:textColor="@color/widget_preview_ink"
        android:textSize="11sp" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_preview_chip"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:maxLines="1"
        android:text="@string/widget_quick_analysis"
        android:textColor="@color/widget_preview_ink"
        android:textSize="11sp" />
</LinearLayout>
