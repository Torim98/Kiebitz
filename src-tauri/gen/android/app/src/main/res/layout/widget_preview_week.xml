<?xml version="1.0" encoding="utf-8"?>
<!-- Vorschau im Widget-Auswahldialog · statisches Abbild ohne echte Daten. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_preview_surface"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_week_name"
        android:textColor="@color/widget_preview_ink_muted"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_preview_week_ratio"
        android:textColor="@color/widget_preview_ink"
        android:textSize="18sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_preview_chip" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_preview_week_days"
        android:textColor="@color/widget_preview_ink_muted"
        android:textSize="11sp" />
</LinearLayout>
