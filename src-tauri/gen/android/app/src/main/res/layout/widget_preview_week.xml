<?xml version="1.0" encoding="utf-8"?>
<!--
  Vorschau im Widget-Auswahldialog · ein statisches Abbild dessen, was das
  Widget mit Daten zeigt: dieselbe Karte, dieselbe Kopfzeile mit den
  Trainingstagen, dieselbe Kennzahl, derselbe nach Bereichen eingefärbte
  Balken. Er ist hier von Hand nachgebaut, weil eine Vorschau keine Daten hat ·
  die Verhältnisse entsprechen den Beispielwerten daneben.

  Farbflächen (Balken, Punkte) sind FrameLayouts und keine <View>: Eine
  previewLayout wird als RemoteViews aufgeblasen, und RemoteViews lässt nur
  eine feste Liste von Klassen zu · android.view.View gehört nicht dazu. Mit
  <View> stand im Auswahldialog „Widget kann nicht geladen werden".

-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_surface"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="9dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_widget_bird"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/widget_week_short"
            android:textColor="@color/widget_ink2"
            android:textSize="12sp" />

        <FrameLayout
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/widget_dot_accent" />

        <FrameLayout
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_dot_accent" />

        <FrameLayout
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_dot_accent" />

        <FrameLayout
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_dot_open" />

        <FrameLayout
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_dot_open" />

        <!--
          „3 von 5 Tagen" stand hier neben den Punkten und sagte dasselbe wie
          sie. Der Auswahldialog zeichnet die Vorschau auf der *Mindest*breite
          des Widgets (110 dp) und nicht auf seiner Vorgabegröße · dort blieb
          für den Namen dann nichts übrig, und aus „Woche" wurde „…". Die
          Glance-Fassung blendet dieselbe Angabe unterhalb von 200 dp Breite
          ebenfalls aus.
        -->
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_preview_week_ratio"
        android:textColor="@color/widget_ink"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:background="@drawable/widget_track">

        <FrameLayout
            android:layout_width="78dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_seg_tactics" />

        <FrameLayout
            android:layout_width="54dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:background="@drawable/widget_seg_play" />

        <FrameLayout
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:background="@drawable/widget_seg_openings" />

        <FrameLayout
            android:layout_width="15dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:background="@drawable/widget_seg_analysis" />
    </LinearLayout>
</LinearLayout>
