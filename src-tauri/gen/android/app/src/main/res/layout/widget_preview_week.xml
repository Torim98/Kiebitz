<?xml version="1.0" encoding="utf-8"?>
<!--
  Vorschau im Widget-Auswahldialog · ein statisches Abbild dessen, was das
  Widget mit Daten zeigt: dieselbe Karte, dieselbe Kopfzeile mit den
  Trainingstagen, dieselbe Kennzahl, derselbe Balken.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_surface"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="9dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_widget_bird"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="@string/widget_week_short"
            android:textColor="@color/widget_ink2"
            android:textSize="12sp" />

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/widget_dot_accent" />

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_dot_accent" />

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_dot_accent" />

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_dot_open" />

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_dot_open" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:maxLines="1"
            android:text="@string/widget_preview_week_days"
            android:textColor="@color/widget_ink3"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_preview_week_ratio"
        android:textColor="@color/widget_ink"
        android:textSize="20sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_track">

        <View
            android:layout_width="90dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_bar" />
    </FrameLayout>
</LinearLayout>
