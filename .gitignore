src-tauri/gen/schemas/

# Stockfish binaries (bundled separately)
src-tauri/binaries/

# Zwischenstände der Icon-Vektorisierung · ein Dutzend Megabyte JSON je Lauf,
# aus denen nichts gebaut wird. Das fertige Icon liegt daneben als PNG.
src-tauri/icons/source-icon/

# Local database & user data
*.sqlite
*.sqlite-journal
*.db

# Environment / secrets
.env
.env.*
# Signing keystores — never commit (public repo). Store as GitHub secrets.
*.jks
*.keystore
*.p12

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

