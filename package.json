{
  "name": "kiebitz",
  "private": true,
  "version": "0.11.0",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://kiebitz.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Torim98/Kiebitz.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "pins:sync": "node scripts/generate-stockfish-notice.mjs",
    "pins:check": "node scripts/generate-stockfish-notice.mjs --check && node scripts/check-toolchain-pin-consumers.mjs",
    "pieces:sync": "node scripts/generate-piece-glyphs.mjs",
    "pieces:check": "node scripts/generate-piece-glyphs.mjs --check",
    "share:sync": "node scripts/sync-share-codec.mjs",
    "share:check": "node scripts/sync-share-codec.mjs --check",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:scripts": "node --test scripts/*.test.mjs",
    "store-assets:marketing": "python scripts/compose-store-assets-v3.py artifacts/store-assets artifacts/store-assets-v3 artifacts/Kiebitz-Play-Store-Assets-v3.zip",
    "locales:check": "node scripts/check-locales.mjs",
    "licenses": "node scripts/generate-third-party-licenses.mjs",
    "licenses:check": "node scripts/generate-third-party-licenses.mjs --check",
    "openings:generate": "node scripts/generate-opening-names.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-barcode-scanner": "^2.4.5",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "chess.js": "^1.0.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-chessboard": "^4.6.0",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  }
}
